{
  "name": "web",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel --filter scholarship-app --filter icaptur-website --filter irepo-dashboard",
    "dev:scholarship": "turbo run dev --filter scholarship-app",
    "dev:icaptur-website": "turbo run dev --filter icaptur-website",
    "dev:irepo-dashboard": "turbo run dev --filter irepo-dashboard",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "generate-api:sso": "turbo run generate-api:sso --filter shared",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}